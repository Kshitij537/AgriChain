# Backend environment variables (copy to backend/.env)

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agrichain_db
DB_LOG_QUERIES=false

# Auth
JWT_SECRET=change_me

# Satellite microservice (Flask) used for NDVI calculations
# Default: satellite-service/app.py uses SERVER_PORT=5001
PYTHON_SERVICE_URL=http://localhost:5001
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=10000

# Optional alert tuning
# Absolute NDVI drop threshold to trigger alert (e.g. 0.12 means 12 points)
NDVI_ALERT_DROP_ABS=0.12

# Daily NDVI refresh scheduler
# Runs once per day using server local time.
NDVI_DAILY_REFRESH_ENABLED=true
NDVI_DAILY_REFRESH_RUN_ON_STARTUP=true
NDVI_DAILY_REFRESH_HOUR=6
NDVI_DAILY_REFRESH_MINUTE=0

# Weather API Configuration
# Using Open-Meteo - Free, open-source, no API key required!
# Documentation: https://open-meteo.com/en/docs
WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_DURATION=10

# Gemini AI field advice
GEMINI_API_KEY=API
GEMINI_MODEL=gemini-3.5-flash

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ============================================================================
# Market Intelligence module
# ============================================================================

# --- Market price provider (keyless) --------------------------------------
# Which provider supplies mandi prices. Registered: mandi_api
# Adding MSAMB/CEDA later is a new provider file + a factory entry, not a rewrite.
MARKET_PRICE_PROVIDER=mandi_api
# Keyless aggregator API. NO credential is required or accepted - there is no key
# to leak, and none must ever reach the frontend.
MANDI_API_BASE_URL=https://mandi-api.onrender.com/v1
# Generous: the upstream host sleeps when idle and cold-starts slowly.
MANDI_API_TIMEOUT_MS=60000
MANDI_API_RETRIES=2
MANDI_API_DEFAULT_STATE=Maharashtra

# --- Price freshness thresholds (days) ------------------------------------
# An observation older than MARKET_PRICE_STALE_DAYS is excluded from ranking.
MARKET_PRICE_FRESH_DAYS=2
MARKET_PRICE_RECENT_DAYS=7
MARKET_PRICE_STALE_DAYS=30
MARKET_MAX_PRICE_AGE_DAYS=30

# --- Road routing ---------------------------------------------------------
# 'osrm' (default, no key needed) | 'openrouteservice' | 'none'
# 'none' forces the straight-line fallback, which is always labelled as an
# estimate and never presented as a road route.
ROUTING_PROVIDER=osrm
# The public demo server is rate limited; self-host for real load.
OSRM_BASE_URL=https://router.project-osrm.org
ORS_BASE_URL=https://api.openrouteservice.org
ORS_API_KEY=
ROUTING_TIMEOUT_MS=8000
ROUTING_CACHE_TTL_MS=86400000
# Straight-line -> road multiplier, used ONLY by the labelled fallback.
ROUTING_DETOUR_FACTOR=1.3

# --- Candidate market search ----------------------------------------------
MARKET_SEARCH_RADIUS_KM=150
MARKET_MAX_CANDIDATES=8

# --- Price prediction (Python ML service) ---------------------------------
# Set to false to skip the ML hop entirely; recommendations still work and
# report price_prediction_available: false.
PRICE_PREDICTION_ENABLED=true
PRICE_PREDICTION_TIMEOUT_MS=6000

# --- Selling costs (INDICATIVE defaults, not verified statutory rates) ----
# Confirm against your own APMC committee, or set MARKET_APPLY_SELLING_COSTS
# to false to model a sale with no deductions.
MARKET_APPLY_SELLING_COSTS=true
MARKET_COMMISSION_PERCENT=4
MARKET_CESS_PERCENT=1.05
MARKET_HAMALI_PER_QUINTAL=15
MARKET_WEIGHING_PER_QUINTAL=5

# --- Sell-now vs wait thresholds ------------------------------------------
# Waiting must beat selling now by BOTH of these, or the answer is sell.
SELL_WAIT_MIN_GAIN_RUPEES=250
SELL_WAIT_MIN_GAIN_PERCENT=2

# --- Gemini narration (explanation only; never computes a figure) ---------
# Tried in order after GEMINI_MODEL fails (404 for a retired model name, 503
# when a popular model is overloaded). Set empty to disable the chain.
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# --- Transporter discovery (Google Places API New) -------------------------
# Enable "Places API (New)" in Google Cloud Console and attach billing, then
# paste the key here. BACKEND ONLY - never prefix it with VITE_ / NEXT_PUBLIC_,
# and never reference it from React: the frontend calls /api/transport/search.
# Leave blank and the feature degrades to a clear "lookup not configured" state
# while the estimated transport cost keeps working.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
# Set to false to switch the feature (and its billing) off without removing the key
TRANSPORT_SEARCH_ENABLED=true
GOOGLE_PLACES_TIMEOUT_MS=8000
GOOGLE_PLACES_LANGUAGE=en
GOOGLE_PLACES_REGION=IN
# Location-bias circle around the mandi, in metres (max 50000)
TRANSPORT_SEARCH_RADIUS_M=20000
# Transporters shown to the farmer
TRANSPORT_MAX_RESULTS=8
# Cost ceiling: Place Details is billed per call, so cap lookups per search
TRANSPORT_MAX_DETAIL_LOOKUPS=10
# In-memory only, never persisted. Stays well inside the 30-day Places caching limit.
TRANSPORT_CACHE_TTL_MS=21600000
# How long a straight-line routing fallback is reused before OSRM is retried.
# Short on purpose: the usual cause is one slow response from the free public
# server, and a reload should get real road distances back.
ROUTING_FALLBACK_CACHE_MS=10000
