# Backend environment variables (copy to backend/.env)

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=agrichain_db
DB_LOG_QUERIES=false

# Auth
JWT_SECRET=change_me

# Satellite microservice (Flask) used for NDVI calculations
# Default: satellite-service/app.py uses SERVER_PORT=5001
PYTHON_SERVICE_URL=http://localhost:5001
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT=10000

# Optional alert tuning
# Absolute NDVI drop threshold to trigger alert (e.g. 0.12 means 12 points)
NDVI_ALERT_DROP_ABS=0.12

# Daily NDVI refresh scheduler
# Runs once per day using server local time.
NDVI_DAILY_REFRESH_ENABLED=true
NDVI_DAILY_REFRESH_RUN_ON_STARTUP=true
NDVI_DAILY_REFRESH_HOUR=6
NDVI_DAILY_REFRESH_MINUTE=0

# Weather API Configuration
# Using Open-Meteo - Free, open-source, no API key required!
# Documentation: https://open-meteo.com/en/docs
WEATHER_API_URL=https://api.open-meteo.com/v1
WEATHER_CACHE_DURATION=10

# Gemini AI field advice
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173
