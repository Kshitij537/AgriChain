{
  "name": "agrichain-backend",
  "version": "1.0.0",
  "description": "AgriChain Backend API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed:market": "node src/scripts/seedMarketData.js",
    "seed:demo-prices": "node src/scripts/seedDemoPrices.js",
    "test": "node --test tests/*.test.js",
    "test:unit": "node --test tests/money.test.js tests/transportCost.test.js tests/netReturn.test.js tests/spoilage.test.js tests/ranking.test.js tests/sellTiming.test.js tests/routing.test.js tests/marketValidator.test.js",
    "test:integration": "node --test tests/recommend.integration.test.js",
    "test:watch": "node --test --watch tests/*.test.js",
    "seed:marketplace": "node src/scripts/seedMarketplaceDemo.js",
    "map:markets": "node src/scripts/mapProviderMarkets.js",
    "ingest:prices": "node src/scripts/ingestPrices.js"
  },
  "dependencies": {
    "axios": "^1.14.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "nodemon": "^2.0.20"
  }
}
