# Satellite Service Configuration

# Google Earth Engine Service Account Key
# Download from Google Cloud Console and place as JSON file
EE_SERVICE_ACCOUNT_KEY=./service-account.json

# Flask Environment
FLASK_ENV=development
FLASK_DEBUG=True

# CORS Configuration
# Match your frontend URL
CORS_ORIGIN=http://localhost:5173

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5002
